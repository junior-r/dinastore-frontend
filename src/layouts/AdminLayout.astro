---
import AdminNav from '../components/react/admin/AdminNav';
import Layout from './Layout.astro';

interface Props {
  title?: string;
}

const { title = 'Admin | DinaStore' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<Layout title={title}>
  <!-- Stacked on a phone (the nav becomes a tab strip above the content), side
       by side from `md` up. -->
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-8 sm:px-6 md:flex-row md:gap-10 md:py-10">
    <aside class="shrink-0 md:w-52">
      <AdminNav currentPath={currentPath} client:load />
    </aside>
    <main class="min-w-0 flex-1">
      <slot />
    </main>
  </div>
</Layout>
